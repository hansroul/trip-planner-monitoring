# Site de suivi PoppyTrip : configuration d'EXEMPLE (valeurs fictives uniquement).
# Copier en .env (jamais versionné) et remplacer chaque valeur. Voir le README.
# Le serveur refuse de démarrer si une variable obligatoire manque ou est faible.

# --- Obligatoires -----------------------------------------------------------------------
# Origine publique du site (HTTPS obligatoire en production), sans chemin.
PUBLIC_BASE_URL=http://localhost:3000
# Segment aléatoire sous lequel TOUT le site est monté. Générer : openssl rand -hex 24
ADMIN_PATH_PREFIX=exemple-a-generer-0123456789abcdef
# Le seul compte autorisé : ton e-mail PoppyTrip...
ADMIN_EMAIL=admin@example.com
# ... et l'empreinte argon2id de ton mot de passe : la colonne password_hash de ton compte
# PoppyTrip copiée telle quelle, ou le résultat de « npm run hash-password ». Jamais le mot de passe.
ADMIN_PASSWORD_HASH=fictif-a-remplacer
# Au moins 32 octets aléatoires. Générer : openssl rand -base64 48
SESSION_SECRET=fictif-a-remplacer
# Rôles dédiés (JAMAIS la DATABASE_URL de PoppyTrip).
DATABASE_URL_READONLY=postgres://monitoring_reader:dev-only-reader-pw@localhost:5432/poppytrip_dev
DATABASE_URL_APP=postgres://monitoring_app_rw:dev-only-app-pw@localhost:5432/poppytrip_dev

# --- Facultatives (valeurs par défaut entre parenthèses) --------------------------------
# NODE_ENV (production) · PORT (3000) · LOG_LEVEL (info) · TRUST_PROXY_HOPS (0 ; Railway : 1)
NODE_ENV=development
# TIMEZONE (Europe/Brussels) · MAIN_APP_URL : lien « Application principale » (sans valeur : pas de lien)
# DB_SIZE_LIMIT_BYTES / STORAGE_LIMIT_BYTES : sans valeur, « limite non configurée »
# USD_TO_EUR_RATE : taux pour la marge estimée
# CREDIT_WARN_PERCENT (70) · CREDIT_CRITICAL_PERCENT (90)
# STORAGE_WARN_PERCENT (80) · STORAGE_CRITICAL_PERCENT (90) · SATURATION_ALERT_DAYS (30)
# ANTHROPIC_PROVIDER_LABEL (anthropic)
# Recoupement Anthropic : ANTHROPIC_ADMIN_KEY + ANTHROPIC_API_BASE_URL (voir README)
# Alertes e-mail : ALERTS_ENABLED=true + SMTP_HOST, SMTP_PORT (587), SMTP_SECURE (false),
#   SMTP_USER, SMTP_PASSWORD, SMTP_FROM, ALERT_EMAIL_TO
# DB_SSL_CA : certificat PEM si la base est jointe hors réseau privé
