# Site de suivi PoppyTrip : configuration d'EXEMPLE (valeurs fictives uniquement).
# Copier en .env (jamais versionné) et remplacer chaque valeur. Voir le README pour le détail.
# Le serveur refuse de démarrer si une variable manque ou est faible.

# --- Serveur ----------------------------------------------------------------------------
# production (par défaut) | development | test
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Nombre de mandataires inverses devant le service (Railway : 1 ; local : 0)
TRUST_PROXY_HOPS=0

# --- Adresses ---------------------------------------------------------------------------
# Origine publique du site (HTTPS obligatoire en production), sans chemin.
PUBLIC_BASE_URL=http://localhost:3000
# Segment aléatoire sous lequel TOUT le site est monté (24 à 128 caractères [A-Za-z0-9_-]).
# Générer : openssl rand -hex 24
ADMIN_PATH_PREFIX=exemple-a-generer-0123456789abcdef
# Lien vers l'application principale (affiché dans l'en-tête).
MAIN_APP_URL=https://app.example.com

# --- Connexion OpenID Connect (Microsoft, comptes personnels) ---------------------------
# Émetteur de l’autorité « consumers » : valeur exacte dans le README (section 3).
OIDC_ISSUER=https://login.example.com/tenant-fictif/v2.0
OIDC_CLIENT_ID=00000000-0000-0000-0000-000000000000
OIDC_CLIENT_SECRET=fictif-a-remplacer
# = PUBLIC_BASE_URL + "/" + ADMIN_PATH_PREFIX + "/auth/callback"
OIDC_REDIRECT_URI=http://localhost:3000/exemple-a-generer-0123456789abcdef/auth/callback
# L'UNIQUE adresse autorisée (compte Microsoft personnel).
ADMIN_EMAIL=admin@example.com
# Identifiant stable du compte (revendication sub) : à renseigner après la première connexion.
ADMIN_OIDC_SUB=

# --- Session ----------------------------------------------------------------------------
# Au moins 32 octets aléatoires. Générer : openssl rand -base64 48
SESSION_SECRET=fictif-a-remplacer

# --- Bases de données (JAMAIS la DATABASE_URL de PoppyTrip) ------------------------------
# Rôle monitoring_reader (lecture seule des vues monitoring_*).
DATABASE_URL_READONLY=postgres://monitoring_reader:dev-only-reader-pw@localhost:5432/poppytrip_dev
# Rôle monitoring_app_rw (schéma monitoring_app).
DATABASE_URL_APP=postgres://monitoring_app_rw:dev-only-app-pw@localhost:5432/poppytrip_dev
# Certificat d'autorité PEM facultatif si la base est jointe hors réseau privé (\n accepté).
DB_SSL_CA=

# --- Affichage et limites ---------------------------------------------------------------
TIMEZONE=Europe/Brussels
# Limites facultatives (octets) : sans valeur, « limite non configurée ».
DB_SIZE_LIMIT_BYTES=
STORAGE_LIMIT_BYTES=
# Taux de conversion facultatif pour la marge (coûts IA en USD, revenus en EUR).
USD_TO_EUR_RATE=

# --- Seuils d'alerte --------------------------------------------------------------------
CREDIT_WARN_PERCENT=70
CREDIT_CRITICAL_PERCENT=90
STORAGE_WARN_PERCENT=80
STORAGE_CRITICAL_PERCENT=90
# Alerte quand la saturation prévue est à moins de N jours.
SATURATION_ALERT_DAYS=30

# --- Crédit Anthropic -------------------------------------------------------------------
# Valeur du champ provider qui désigne Anthropic dans monitoring_ai_costs_daily.
ANTHROPIC_PROVIDER_LABEL=anthropic
# Facultatif : recoupement avec l'API d'administration (clé sk-ant-admin…, jamais envoyée au navigateur).
ANTHROPIC_ADMIN_KEY=
# URL de l’API Anthropic (voir README), obligatoire seulement avec ANTHROPIC_ADMIN_KEY.
ANTHROPIC_API_BASE_URL=
ANTHROPIC_API_VERSION=2026-10-21

# --- Alertes par e-mail (facultatives) ---------------------------------------------------
ALERTS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
