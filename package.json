{
  "name": "poppytrip-monitoring",
  "private": true,
  "version": "0.1.0",
  "description": "Site de suivi privé de PoppyTrip (service séparé, lecture seule)",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "check:secrets": "node scripts/check-secrets.mjs",
    "db:dev:init": "tsx scripts/dev-db.ts",
    "hash-password": "tsx scripts/hash-password.ts",
    "db:ca": "node scripts/db-ca.mjs",
    "start:local": "node --env-file=.env dist/server/server/index.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "argon2": "0.45.2",
    "fastify": "5.12.8",
    "nodemailer": "10.6.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
}
